# MedLens Backend Configuration
# ------------------------------

# Database (defaults to local SQLite medlens.db if not provided)
DATABASE_URL=sqlite:///./medlens.db

# JWT Security
SECRET_KEY=medlens-hackathon-super-secret-key-2026-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider (Optional: Heuristic fallback parser is used if not provided)
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Server Host & Port
HOST=127.0.0.1
PORT=8000
